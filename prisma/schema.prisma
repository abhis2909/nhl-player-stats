// ============================================================
// Fantasy Hub — credits ledger + 5 minigames
//
// Moved here from fantasy-hub/schema.prisma (Prisma's own convention —
// `prisma/schema.prisma` at the repo root — so every `prisma` CLI
// command works with no `--schema` flag). fantasy-hub/README.md is
// still the human-readable design doc; keep the two in sync.
//
// PHASE 1 STATUS (see fantasy-hub/README.md for the full story):
// User (username/password auth, name set on first login) and
// DailyGuess (linking the already-live "Guess the Player" game to
// accounts) are ACTIVE this phase. Every other model —
// CreditTransaction, Bet/BetEntry, Faceoff, GridBoard/GridEntry,
// Card/Pack/UserCard/PackOpening, YahooMatchupCache — exists in the DB
// from the first migration on, but nothing reads/writes them yet.
// Yahoo OAuth is deferred entirely.
// ============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------- Identity ----------

model User {
  id        String   @id @default(cuid())
  username  String   @unique // commissioner-assigned; the login handle
  displayName String? // set by the person themselves on first login; falls back to username in UI until then

  // First-login setup: the commissioner's CLI script
  // (fantasy-hub/scripts/create-user.js) creates a User with just a
  // username, passwordHash left null. The first login attempt for that
  // username sets passwordHash (a scrypt hash — see
  // api/_lib/fantasyAuth.js, never stored in plaintext) AND displayName
  // in one step — the login form asks for a name alongside the chosen
  // password the first time. After that, it's a normal
  // username+password login.
  passwordHash String?

  // Cheap brute-force guard — there's no other rate-limiting layer in
  // front of these serverless functions.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  yahooTeamKey String?  @unique // e.g. "453.l.12345.t.4" — unused in Phase 1, kept for future Yahoo linking
  createdAt    DateTime @default(now())

  // Fantasy Hub page: a pixel-art avatar image, commissioner-managed —
  // not a live upload feature. The site owner sends Claude a photo/PNG
  // per manager, Claude saves it under /avatars and points this at it
  // (fantasy-hub/scripts/set-avatar.js), swappable over the season the
  // same way. Null renders as a placeholder silhouette (avatar.js's
  // buildAvatarImg()) until one is set.
  avatarUrl String?

  // A manager's own self-submitted avatar request, awaiting commissioner
  // review — separate from avatarUrl itself so a request never takes
  // effect until approved (Admin -> Users). Stored as a data: URI
  // (submitted directly from fantasy-hub.js's file picker, resized/
  // compressed client-side first) rather than a real upload/CDN, since
  // there's no storage infra and no function-count headroom for one —
  // see api/fantasy/session.js's PATCH handler. avatarRequestedAt null
  // means no pending request; approving or rejecting clears all three.
  avatarRequestUrl   String?
  avatarRequestNote  String?
  avatarRequestedAt  DateTime?

  transactions CreditTransaction[] // unused in Phase 1
  betEntries   BetEntry[]          // unused in Phase 1
  faceoffsA    Faceoff[]     @relation("FaceoffUserA") // unused in Phase 1
  faceoffsB    Faceoff[]     @relation("FaceoffUserB") // unused in Phase 1
  dailyGuesses DailyGuess[]        // ACTIVE in Phase 1
  gridEntries  GridEntry[]         // unused in Phase 1
  cards        UserCard[]          // unused in Phase 1
  packOpenings PackOpening[]       // unused in Phase 1
  trades       Trade[]             // ACTIVE — Fantasy Hub page's Trade Analyzer
}

// The SINGLE site administrator — a completely separate concept from
// User above (league members playing games). Gates admin.html (stat
// column config) and anything else site-configuration-related later.
// Only one email is ever allowed to have a row here: whatever
// ADMIN_EMAIL is set to (api/fantasy/admin-login.js checks this before
// touching the table at all) — so this model doesn't need a "role"
// field or multi-admin support, it's deliberately singular. First
// login for that email (passwordHash null) sets the password, exactly
// like User's first-login flow, just without a separate displayName
// step. Own session/cookie (see api/_lib/fantasyAuth.js's
// getSessionAdmin/ADMIN_SESSION_COOKIE_NAME) — being logged in as the
// admin and being logged in as a User (league member) are orthogonal.
model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
}

// ---------- Shared credits ledger ----------
// Balance is never stored directly — it's SUM(amount) for a user.
// Every stake, payout, and reward is its own row here, which gives
// you a full audit trail and avoids sync bugs across games.
// Unused in Phase 1 — kept so the table exists from the first
// migration on, ready for when credits are introduced.

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int // positive = credit in, negative = debit out
  reason    String // "season_seed" | "bet_stake" | "bet_payout" | "daily_reward" | "faceoff_stake" | "faceoff_payout" | "grid_reward" | "admin_adjustment"
  refType   String? // "Bet" | "Faceoff" | "DailyGuess" | "GridEntry"
  refId     String?
  // Free-text context for a manual admin_adjustment ("prize for trivia
  // night", "correcting a sync bug") — null for every system-generated
  // reason, where reason/refType/refId already say enough. See
  // api/fantasy/admin-users.js's adjustCredits action.
  note      String?
  createdAt DateTime @default(now())
}

// ---------- Cached Yahoo data ----------
// Pulled with ONE commissioner-level OAuth token via a scheduled
// job, not per-user tokens — Yahoo's access rules are based on
// league membership, so one token can read the whole league.
// Deferred entirely in Phase 1 (see fantasy-hub/README.md).

model YahooMatchupCache {
  matchupKey String   @id // Yahoo's matchup identifier
  weekKey    String
  rawData    Json
  fetchedAt  DateTime @default(now())
}

// ---------- Game 1: Betting (matchup / category / over-under) ----------
// Unused in Phase 1.

model Bet {
  id         String    @id @default(cuid())
  type       String // "matchup_winner" | "category_winner" | "over_under"
  matchupKey String
  category   String? // e.g. "goals" — category/O-U bets only
  line       Float? // O/U line, if applicable
  status     String    @default("open") // "open" | "locked" | "settled" | "void"
  resultJson Json?
  locksAt    DateTime // matchup start time
  createdAt  DateTime  @default(now())

  entries BetEntry[]
}

model BetEntry {
  id        String   @id @default(cuid())
  betId     String
  bet       Bet      @relation(fields: [betId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  side      String // "team_a" | "team_b" | "over" | "under"
  amount    Int
  payout    Int?
  createdAt DateTime @default(now())
}

// ---------- Game 2: Draft faceoff ----------
// Unused in Phase 1.

model Faceoff {
  id        String   @id @default(cuid())
  userAId   String
  userA     User     @relation("FaceoffUserA", fields: [userAId], references: [id])
  userBId   String
  userB     User     @relation("FaceoffUserB", fields: [userBId], references: [id])
  stake     Int
  metric    String // the hard number that decides it, e.g. "season_fantasy_points"
  scoreA    Float?
  scoreB    Float?
  winnerId  String?
  status    String   @default("pending") // "pending" | "accepted" | "resolved" | "declined"
  createdAt DateTime @default(now())
}

// ---------- Game 3: Daily guesser (Poeltl-style) ----------
// ACTIVE in Phase 1 — links the already-live guesswho.html/.js game to
// accounts. DailyPlayer is a frozen, get-or-create-per-date snapshot of
// whichever mystery player guesswho.js's own deterministic
// pickMysteryPlayer(pool, date) algorithm picks for that date (see
// api/_lib/guessWhoPool.js — must replicate that logic byte-for-byte,
// including the same p.birthDate/p.heightInInches pool filter, so
// anonymous (client-computed) and logged-in (server-recorded) players
// always see the identical daily answer). DailyGuess.guesses is a bare
// array of nhlPlayerId ints (not full bio objects — the client
// re-hydrates from its own already-loaded pool), replaced wholesale on
// every sync rather than appended, so a fire-and-forget sync call is
// trivially idempotent even if it fires more than once or out of order.

model DailyPlayer {
  date        String @id // "2026-08-16"
  nhlPlayerId Int
  attributes  Json // snapshot: team, position, nationality, age, etc.
}

model DailyGuess {
  id        String   @id @default(cuid())
  date      String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  guesses   Json // array of guessed nhlPlayerId ints, in guess order — full snapshot, replaced (not appended) on every sync
  solved    Boolean  @default(false) // computed server-side from `guesses` vs. DailyPlayer.nhlPlayerId, never trusted from the client
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, userId])
}

// ---------- Game 4: Immaculate-grid board ----------
// Unused in Phase 1.

model GridBoard {
  date String @id
  rows Json // 3 constraints, e.g. ["team:BOS", "nationality:CAN", "30+ goal season"]
  cols Json
}

model GridEntry {
  id           String   @id @default(cuid())
  date         String
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  answers      Json // 9 cells → nhlPlayerId or null
  correctCount Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([date, userId])
}

// ---------- Game 5: Player packs (collectibles) ----------
// Unused in Phase 1. Cost comes out of the same credits ledger as
// everything else — a purchase is just a CreditTransaction with reason
// "pack_purchase".

model Card {
  id          String  @id @default(cuid())
  nhlPlayerId Int     @unique
  name        String
  team        String
  position    String
  rarity      String // "common" | "rare" | "legendary" | "hot_streak" — hot_streak is optional, tied to a live scoring streak
  season      String // e.g. "2026-27" — lets the pool refresh year to year
  imageUrl    String?

  owners UserCard[]
}

model Pack {
  id        String @id @default(cuid())
  name      String // "Standard Pack" — themed packs (Original Six, Rookies) can be added later as more rows
  cost      Int // credits
  cardCount Int    @default(5)
  oddsJson  Json // rarity → probability weight, e.g. {"common":70,"rare":25,"legendary":5}

  openings PackOpening[]
}

model UserCard {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id])
  quantity   Int      @default(1) // duplicates stack here — use this to drive the auto-scrap/refund logic
  acquiredAt DateTime @default(now())

  @@unique([userId, cardId])
}

model PackOpening {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  packId        String
  pack          Pack     @relation(fields: [packId], references: [id])
  pulledCardIds Json // array of Card IDs pulled this opening — drives the reveal animation + history
  createdAt     DateTime @default(now())
}

// ---------- Fantasy Hub page: Trade Analyzer ----------
// A lightweight "grade this trade" tool — deliberately NOT tied to real
// fantasy rosters/leagues (no Team/Roster model exists). sideA/sideB are
// point-in-time snapshots of whichever players the user picked (not live
// FKs to any roster), so a logged trade always renders the same way even
// as real stats keep changing. sideAOverall/sideBOverall are the average
// ratePool() `.overall` across each side, computed client-side against
// the full current-season pool (never against just the 2-6 traded
// players — see ratings.js's percentileRank() small-N caveat) and sent
// up alongside the snapshot rather than recomputed server-side.
model Trade {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  sideA        Json // [{ playerId, name, team, pos, overall }, ...]
  sideB        Json
  sideAOverall Float
  sideBOverall Float
  winner       String // "A" | "B" | "even"
  createdAt    DateTime @default(now())
}

// ---------- Stats page projections ----------
// Backs the Stats page's "Projected" season option (app.js/projections.js)
// and its two admin sub-tabs (Deployment, Projection Methodology).
// Deliberately separate from the Fantasy Hub games above — this is
// site-wide Stats-page config, not league/user data — but lives in the
// same DB since it's the same admin-gated infrastructure (Admin above).

// One admin-entered deployment override per (season, player) — every
// numeric field nullable, so a row can override just one metric and
// leave the rest to fall back to the player's own historical average
// (see projections.js's computeProjection()). No row at all for a
// player is the common case and totally fine — deployment input is an
// optional refinement, not a requirement, so projections work out of
// the box before any admin data entry happens.
model PlayerDeployment {
  id             String   @id @default(cuid())
  season         String // the season being projected, e.g. "2026-27"
  nhlPlayerId    Int
  toiPerGame     Float? // projected minutes/game (skaters)
  ppToiPerGame   Float? // projected power-play minutes/game (skaters)
  gamesProjected Int? // projected games played (skaters) or games started (goalies)
  updatedAt      DateTime @updatedAt

  @@unique([season, nhlPlayerId])
}

// Singular tunable-methodology row — same "deliberately one row" spirit
// as Admin above, not a multi-row settings table (@default("singleton")
// on the id, upserted by that fixed id — see api/fantasy/admin-projection-settings.js).
// seasonWeights is [mostRecent, ..., 4th-most-recent], must sum to 1
// (validated in the API handler, not at the DB layer). Exists so the
// projection's weighting/age-curve behavior can be tuned from
// admin.html without a code change.
model ProjectionSettings {
  id                        String   @id @default("singleton")
  seasonWeights             Json // [w1, w2, w3, w4], newest season first, sums to 1
  ageCurveEnabled           Boolean  @default(true)
  multiplierClipMin         Float    @default(0.85)
  multiplierClipMax         Float    @default(1.15)
  // Shrinkage constant (games) for the Rest-of-Season live projection —
  // blendedRate = g/(g+K)*actualYtdRate + K/(g+K)*modeledRate, where g
  // is the player's real games played so far this season. Small g
  // trusts the model more; large g trusts real results more. See
  // projections.js's buildRestOfSeasonProjection().
  restOfSeasonShrinkageGames Int     @default(20)
  updatedAt                 DateTime @updatedAt
}

// ---------- Stats page: rating methodology ----------
// Admin-tunable version of ratings.js's hardcoded constants
// (POSITION_WEIGHTS/GOALIE_WEIGHTS/MIN_GP_FRACTION/RATING_FLOOR..CEIL/
// RATING_PREMIUM/tierFor() thresholds) — same singular-row spirit as
// ProjectionSettings above. ratings.js's own constants remain the
// DEFAULTS (used as-is if this row never gets saved), so nothing
// changes in production until an admin actually edits this.
model RatingSettings {
  id              String   @id @default("singleton")
  positionWeights Json // { C: {...}, W: {...}, D: {...} }, mirrors ratings.js's POSITION_WEIGHTS shape exactly
  goalieWeights   Json // mirrors GOALIE_WEIGHTS
  minGpFraction   Float    @default(0.2)
  ratingFloor     Int      @default(25)
  ratingCeil      Int      @default(99)
  ratingPremium   Float    @default(1.04)
  tierThresholds  Json // { diamond, amethyst, ruby, emerald, gold } — silver is "anything below gold", no threshold needed
  updatedAt       DateTime @updatedAt
}

// ---------- Stats page: server-side snapshots ----------
// One row per calendar date, upserted — the shared, database-backed
// replacement for what used to be purely a per-browser localStorage
// snapshot (still described that way in snapshots.js's header comment;
// this is what actually populates it now, via api/fantasy/snapshots.js
// and snapshots.js's syncServerSnapshots()). Written either by the
// daily cron (source "cron") or the admin's manual "Retrieve Latest
// Stats" button under Range Ratings (source "admin") — same upsert
// path either way, so retrieving manually mid-day just updates today's
// row instead of creating a duplicate.
model StatsSnapshot {
  date      String   @id // "2026-08-17"
  seasonId  Int
  data      Json // { teamMeta: [[abbrev, meta], ...], skaters: [...], goalies: [...] } — same shape snapshots.js's serializeSeasonData() produces
  source    String // "cron" | "admin"
  createdAt DateTime @default(now())
}
